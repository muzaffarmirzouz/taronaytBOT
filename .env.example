# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
# Your own numeric Telegram id (get it from @userinfobot). Only this user can control the bot.
ADMIN_ID=

# ---- Mureka (platform.mureka.ai -> API Keys) ----
MUREKA_API_KEY=
# MUREKA_MODEL=auto
# MUREKA_N=1                 # songs per request (1 = cheapest)
# MAX_MUREKA_PER_DAY=12      # hard daily cap on paid song requests

# ---- Claude (writes lyrics, prompts, YouTube titles/tags) ----
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# ---- OpenAI (cover images) ----
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_IMAGE_SIZE=1536x1024
# OPENAI_IMAGE_QUALITY=medium

# ---- YouTube (run auth_youtube.py once to get the refresh token) ----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# YT_PRIVACY=public          # public | unlisted | private
# YT_SYNTHETIC_MEDIA=1       # label videos as AI-generated (recommended)

# ---- Schedule (US audience, local times in TIMEZONE) ----
# TIMEZONE=America/New_York
# POST_TIMES=08:00,13:00,19:00   # 3 posts per day
# STOCK_TARGET=6                 # how many ready videos to keep in reserve
# CHANNEL_FOOTER=                # optional line added to every description

# ---- Storage (Railway: mount a Volume at /data) ----
# DATA_DIR=/data

# Video look: random | pulse | bars | wave | plain
VIDEO_STYLE=random

# Share (0-100) of automatic songs sung in Turkish
AUTO_TURKISH_PERCENT=30

# Optional: fixed singing voice (a vocal id you made on the Mureka platform from YOUR OWN or licensed voice). Empty = Mureka picks the voice.
MUREKA_VOCAL_ID=
